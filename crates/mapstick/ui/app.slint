import {
    Button, CheckBox, ComboBox, HorizontalBox, LineEdit, ListView, ProgressIndicator,
    VerticalBox,
} from "std-widgets.slint";

export struct ModelRow {
    id: string,
    name: string,
    version: string,
    media: string,
    released: string,
}

export struct FavouriteRow {
    model_id: string,
    label: string,
    version: string,
}

/// Jedna linijka w ramce ulubionych: nazwa modelu i najnowsze wydanie.
component FavouriteLine inherits Rectangle {
    in property <FavouriteRow> entry;
    callback activated();

    height: 22px;
    border-radius: 3px;
    background: line-touch.has-hover ? #8882 : transparent;

    line-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        spacing: 8px;

        Text {
            text: root.entry.label;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            horizontal-stretch: 1;
            horizontal-alignment: right;
            text: root.entry.version;
            font-size: 11px;
            font-family: "monospace";
            opacity: 0.75;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export struct MediumRow {
    id: string,
    label: string,
    details: string,
    status: string,
    usable: bool,
    installed: string,
}

export component AppWindow inherits Window {
    title: "MapStick";
    min-width: 900px;
    min-height: 640px;
    preferred-width: 1080px;
    preferred-height: 740px;

    // --- wspólne ---
    in property <int> page: 0;
    in property <string> status;
    in property <bool> status-is-error: false;

    // --- widok listy modeli ---
    in property <[string]> brands: ["Hyundai", "Kia", "Genesis"];
    in property <[string]> regions;
    in property <[ModelRow]> models;
    in property <int> total-count;
    in property <bool> busy: false;
    in-out property <int> brand-index: 0;
    in-out property <int> region-index: 0;
    in property <[FavouriteRow]> favourites;
    in property <bool> selected-is-favourite: false;
    in property <string> favourites-note;

    in property <int> selected-index: -1;
    in property <string> detail-name;
    in property <string> detail-id;
    in property <string> detail-version;
    in property <string> detail-media;
    in property <string> detail-released;
    in property <string> detail-size: "—";
    in property <bool> detail-ready: false;

    // --- widok nośnika ---
    in property <[MediumRow]> media;
    in property <bool> media-busy: false;
    in property <int> selected-medium: -1;
    in property <string> target-summary;

    in property <bool> direct-to-medium: false;
    in property <string> space-note;
    in property <bool> target-has-current: false;
    in property <string> leftovers;
    in property <bool> space-warning: false;

    in property <string> output-dir;
    /// Katalog na dysku z gotowymi danymi. Puste — nie ma czego kopiować.
    in property <string> copy-source;
    in property <bool> delete-after-copy: false;
    in property <bool> copying: false;
    in property <bool> downloading: false;
    in property <float> progress: 0;
    in property <string> progress-text;

    // --- potwierdzenie formatowania ---
    in property <bool> format-dialog: false;
    in property <string> format-target;
    in property <bool> formatting: false;

    callback load-models(int, int);
    callback filter-changed(string);
    callback select-row(int);
    callback go-to-media();
    callback go-back();
    callback refresh-media();
    callback select-medium(int);
    callback pick-output-dir();
    callback request-format(int);
    callback confirm-format();
    callback cancel-format();
    callback start-download();
    callback start-copy();
    callback set-delete-after-copy(bool);
    callback cancel-download();
    callback set-direct-mode(bool);
    callback clear-cache();
    callback toggle-favourite();
    callback open-favourite(string);

    VerticalBox {
        padding: 16px;
        spacing: 14px;

        // ================= WIDOK 1: MODELE =================
        if root.page == 0: VerticalLayout {
            spacing: 14px;

            HorizontalLayout {
                spacing: 20px;
                alignment: stretch;

                HorizontalLayout {
                spacing: 10px;
                alignment: start;

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Marka"; font-size: 12px; opacity: 0.7; }
                    brand-box := ComboBox {
                        width: 150px;
                        model: root.brands;
                        current-index <=> root.brand-index;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Region"; font-size: 12px; opacity: 0.7; }
                    region-box := ComboBox {
                        width: 210px;
                        model: root.regions;
                        current-index <=> root.region-index;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: " "; font-size: 12px; }
                    Button {
                        text: root.busy ? "Wczytywanie…" : "Pokaż modele";
                        primary: true;
                        enabled: !root.busy;
                        clicked => {
                            root.load-models(brand-box.current-index, region-box.current-index);
                        }
                    }
                }
                }

                // ---------- ulubione ----------
                Rectangle {
                    width: 380px;
                    border-width: 1px;
                    border-color: #8884;
                    border-radius: 4px;
                    background: #0002;

                    VerticalLayout {
                        padding: 6px;
                        alignment: start;

                        if root.favourites.length == 0: Text {
                            text: root.favourites-note;
                            font-size: 12px;
                            opacity: 0.55;
                            wrap: word-wrap;
                        }

                        // Zwykła kolumna, nie lista przewijana: kilka ulubionych
                        // ma być widocznych od razu, bez sięgania po suwak.
                        if root.favourites.length <= 8: VerticalLayout {
                            for f in root.favourites: FavouriteLine {
                                entry: f;
                                activated => { root.open-favourite(f.model_id); }
                            }
                        }

                        // Powyżej tego progu ramka zjadłaby okno, więc wraca suwak.
                        if root.favourites.length > 8: ListView {
                            height: 8 * 22px;
                            for f in root.favourites: FavouriteLine {
                                entry: f;
                                activated => { root.open-favourite(f.model_id); }
                            }
                        }
                    }
                }
            }

            HorizontalBox {
                spacing: 10px;
                padding: 0px;

                LineEdit {
                    placeholder-text: "Filtruj: nazwa, ID modelu albo wersja…";
                    enabled: root.total-count > 0;
                    edited(text) => { root.filter-changed(text); }
                }

                Text {
                    vertical-alignment: center;
                    text: root.total-count > 0 ? root.models.length + " z " + root.total-count : "";
                    font-size: 12px;
                    opacity: 0.7;
                }
            }

            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: #8884;
                border-radius: 4px;
                background: #8881;

                VerticalLayout {
                    padding: 1px;

                    Rectangle {
                        height: 30px;
                        background: #8882;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            Text { width: 30%; text: "NAZWA"; font-size: 11px; font-weight: 700; vertical-alignment: center; opacity: 0.75; }
                            Text { width: 24%; text: "ID MODELU"; font-size: 11px; font-weight: 700; vertical-alignment: center; opacity: 0.75; }
                            Text { text: "WERSJA"; font-size: 11px; font-weight: 700; vertical-alignment: center; opacity: 0.75; }
                            Text { width: 70px; text: "NOŚNIK"; font-size: 11px; font-weight: 700; vertical-alignment: center; opacity: 0.75; }
                        }
                    }

                    ListView {
                        for row[i] in root.models: Rectangle {
                            height: 32px;
                            background: root.selected-index == i ? #4a90d922 : (touch.has-hover ? #8881 : transparent);

                            touch := TouchArea {
                                clicked => { root.select-row(i); }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                Text { width: 30%; text: row.name; vertical-alignment: center; overflow: elide; }
                                Text { width: 24%; text: row.id; vertical-alignment: center; overflow: elide; font-family: "monospace"; font-size: 12px; }
                                Text { text: row.version; vertical-alignment: center; overflow: elide; font-family: "monospace"; font-size: 12px; }
                                Text { width: 70px; text: row.media; vertical-alignment: center; font-size: 12px; opacity: 0.8; }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 128px;
                border-width: 1px;
                border-color: #8884;
                border-radius: 4px;
                background: #8881;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    if !root.detail-ready: Text {
                        text: "Wybierz model z listy, żeby zobaczyć rozmiar i przygotować nośnik.";
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        opacity: 0.6;
                    }

                    if root.detail-ready: VerticalLayout {
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 10px;

                            Text {
                                text: root.detail-name;
                                font-size: 17px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Rectangle {
                                width: 30px;
                                accessible-role: button;
                                accessible-label: root.selected-is-favourite
                                    ? "Usuń z ulubionych"
                                    : "Dodaj do ulubionych";

                                star-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-favourite(); }
                                }

                                Text {
                                    text: root.selected-is-favourite ? "★" : "☆";
                                    font-size: 24px;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    color: root.selected-is-favourite
                                        ? #e8b32a
                                        : (star-touch.has-hover ? #e8b32a : #8c8c8c);
                                }
                            }

                            Text {
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                text: root.detail-id;
                                font-family: "monospace";
                                font-size: 12px;
                                opacity: 0.7;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: root.detail-version + "   ·   nośnik " + root.detail-media
                                + (root.detail-released == "" ? "" : "   ·   ostatnie dostępne wydanie " + root.detail-released);
                            font-size: 12px;
                            opacity: 0.8;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                text: root.detail-size;
                                font-size: 13px;
                            }
                            Button {
                                text: "Pobierz i przygotuj nośnik →";
                                primary: true;
                                clicked => { root.go-to-media(); }
                            }
                        }
                    }
                }
            }
        }

        // ================= WIDOK 2: NOŚNIK =================
        if root.page == 1: VerticalLayout {
            spacing: 12px;

            HorizontalBox {
                padding: 0px;
                spacing: 12px;
                Button {
                    text: "← Wróć do listy";
                    enabled: !root.downloading && !root.formatting;
                    clicked => { root.go-back(); }
                }
                Text {
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    text: root.target-summary;
                    font-size: 13px;
                    overflow: elide;
                }
                Button {
                    text: root.media-busy ? "Szukam…" : "Odśwież";
                    enabled: !root.media-busy && !root.formatting;
                    clicked => { root.refresh-media(); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: #8884;
                border-radius: 4px;
                background: #8881;

                if root.media.length == 0: VerticalLayout {
                    padding: 24px;
                    spacing: 8px;
                    alignment: center;
                    Text {
                        horizontal-alignment: center;
                        text: root.media-busy ? "Szukam nośników…" : "Nie znaleziono nośnika wymiennego.";
                        opacity: 0.7;
                    }
                    Text {
                        horizontal-alignment: center;
                        text: "Podłącz pendrive i naciśnij „Odśwież”. Dyski wewnętrzne oraz te,\nna których leży system, są celowo pomijane.";
                        font-size: 12px;
                        opacity: 0.55;
                    }
                }

                if root.media.length > 0: ListView {
                    for m[i] in root.media: Rectangle {
                        height: 74px;
                        background: root.selected-medium == i ? #4a90d922 : (mtouch.has-hover ? #8881 : transparent);

                        mtouch := TouchArea {
                            clicked => { root.select-medium(i); }
                        }

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                Text { text: m.label; font-weight: 700; overflow: elide; }
                                Text { text: m.details; font-size: 12px; opacity: 0.75; overflow: elide; }
                                Text {
                                    text: m.installed == "" ? m.id : m.id + "   ·   znaleziono: " + m.installed;
                                    font-size: 11px;
                                    font-family: "monospace";
                                    opacity: 0.6;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    horizontal-alignment: right;
                                    text: m.status;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: m.usable ? #4a9d5f : #c07830;
                                }
                                Button {
                                    text: "Formatuj do exFAT";
                                    enabled: !root.downloading && !root.formatting;
                                    clicked => { root.request-format(i); }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 206px;
                border-width: 1px;
                border-color: #8884;
                border-radius: 4px;
                background: #8881;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 12px;

                        CheckBox {
                            text: "Pobieraj pliki prosto na nośnik wymienny";
                            checked: root.direct-to-medium;
                            enabled: !root.downloading;
                            toggled => { root.set-direct-mode(self.checked); }
                        }

                        Text {
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            text: root.space-note;
                            font-size: 12px;
                            color: root.space-warning ? #c07830 : #808080;
                            overflow: elide;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "Inny katalog…";
                            enabled: !root.downloading;
                            clicked => { root.pick-output-dir(); }
                        }
                        Text {
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            text: root.output-dir == "" ? "nie wybrano celu" : root.output-dir;
                            font-size: 12px;
                            opacity: root.output-dir == "" ? 0.5 : 0.85;
                            overflow: elide;
                        }
                        if !root.downloading && !root.copying && root.copy-source != "": Button {
                            text: "Skopiuj na nośnik";
                            primary: true;
                            enabled: root.output-dir != "" && !root.formatting
                                && !root.target-has-current;
                            clicked => { root.start-copy(); }
                        }
                        if !root.downloading && !root.copying && root.copy-source == "": Button {
                            text: "Pobierz";
                            primary: true;
                            enabled: root.output-dir != "" && !root.formatting
                                && !root.target-has-current;
                            clicked => { root.start-download(); }
                        }
                        if root.downloading || root.copying: Button {
                            text: "Anuluj";
                            clicked => { root.cancel-download(); }
                        }
                    }

                    if root.copy-source != "" && !root.downloading && !root.copying
                            && !root.target-has-current: VerticalLayout {
                        spacing: 3px;

                        Text {
                            text: "To oprogramowanie leży już na dysku — nie trzeba go pobierać drugi raz.";
                            font-size: 12px;
                            color: #4a9d5f;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.copy-source;
                            font-size: 11px;
                            font-family: "monospace";
                            opacity: 0.7;
                            overflow: elide;
                        }
                        CheckBox {
                            text: "usuń z dysku po skopiowaniu";
                            checked: root.delete-after-copy;
                            toggled => { root.set-delete-after-copy(self.checked); }
                        }
                    }

                    if root.target-has-current && !root.downloading: Text {
                        text: "We wskazanym miejscu leży już bieżąca wersja — nie ma czego pobierać.";
                        font-size: 12px;
                        color: #4a9d5f;
                    }

                    if root.leftovers != "" && !root.downloading: HorizontalLayout {
                        spacing: 10px;
                        Text {
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            text: "Pozostałości archiwów na dysku: " + root.leftovers;
                            font-size: 12px;
                            opacity: 0.75;
                        }
                        Button {
                            text: "Wyczyść";
                            clicked => { root.clear-cache(); }
                        }
                    }

                    if root.downloading || root.copying: VerticalLayout {
                        spacing: 4px;
                        ProgressIndicator { height: 8px; progress: root.progress; }
                        Text { text: root.progress-text; font-size: 12px; opacity: 0.8; }
                    }
                }
            }
        }

        Text {
            text: root.status;
            font-size: 12px;
            color: root.status-is-error ? #d05050 : #808080;
            overflow: elide;
        }
    }

    // ================= POTWIERDZENIE FORMATOWANIA =================
    if root.format-dialog: Rectangle {
        background: #000000bb;

        TouchArea {}

        Rectangle {
            width: 520px;
            height: 260px;
            background: #2b2b2b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #c07830;

            VerticalLayout {
                padding: 22px;
                spacing: 12px;

                Text {
                    text: "Skasować wszystko na tym nośniku?";
                    font-size: 19px;
                    font-weight: 700;
                    color: #f0f0f0;
                }

                Text {
                    text: root.format-target;
                    font-size: 13px;
                    font-family: "monospace";
                    color: #e0c090;
                    wrap: word-wrap;
                }

                Text {
                    text: "Formatowanie do exFAT usuwa wszystkie dane z tego nośnika bezpowrotnie. Upewnij się, że wskazany napęd to ten, o którym myślisz.";
                    font-size: 13px;
                    color: #c8c8c8;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Button {
                        text: "Anuluj";
                        clicked => { root.cancel-format(); }
                    }
                    Button {
                        text: root.formatting ? "Formatuję…" : "Formatuj";
                        enabled: !root.formatting;
                        clicked => { root.confirm-format(); }
                    }
                }
            }
        }
    }
}
