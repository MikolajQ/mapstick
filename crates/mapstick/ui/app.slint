import {
    Button, CheckBox, ComboBox, HorizontalBox, LineEdit, ListView, ProgressIndicator,
    VerticalBox,
} from "std-widgets.slint";

export struct ModelRow {
    id: string,
    name: string,
    version: string,
    media: string,
    released: string,
}

/// Jeden z pojazdów, które serwis przypisał do numeru VIN.
export struct VinChoice {
    title: string,
    details: string,
}

export struct FavouriteRow {
    model_id: string,
    label: string,
    version: string,
}

/// Jedna linijka w ramce ulubionych: nazwa modelu i najnowsze wydanie.
component FavouriteLine inherits Rectangle {
    in property <FavouriteRow> entry;
    callback activated();

    height: 22px;
    border-radius: 3px;
    background: line-touch.has-hover ? #8882 : transparent;

    line-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        spacing: 8px;

        Text {
            text: root.entry.label;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            horizontal-stretch: 1;
            horizontal-alignment: right;
            text: root.entry.version;
            font-size: 11px;
            font-family: "monospace";
            opacity: 0.75;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export struct MediumRow {
    id: string,
    label: string,
    details: string,
    status: string,
    usable: bool,
    /// Model odczytany z nośnika i jego wersja — osobno, bo razem tworzyły
    /// wiersz szerszy niż okno.
    installed_model: string,
    installed_version: string,
    /// Rozmiar plików poprzedniego wydania. Puste — nie ma czego usuwać.
    stale: string,
}

/// Krzyżyk z zawijanym opisem.
///
/// Widgetowy `CheckBox` trzyma napis w jednym wierszu i przy dłuższym zdaniu
/// rozpycha rząd, wypychając sąsiednie przyciski poza okno.
component WrapCheckBox inherits Rectangle {
    in property <string> caption;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    min-height: 20px;

    check-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.toggled(!root.checked); }
    }

    HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 16px;
                height: 16px;
                border-width: 1px;
                border-radius: 3px;
                border-color: !root.enabled
                    ? #88888844
                    : (check-touch.has-hover ? #4a90d9 : #888888aa);
                background: root.checked ? #4a90d9 : transparent;

                Text {
                    text: root.checked ? "✓" : "";
                    color: #ffffff;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.caption;
            font-size: 14px;
            vertical-alignment: center;
            wrap: word-wrap;
            opacity: root.enabled ? 1.0 : 0.5;
        }
    }
}

/// Przycisk czynności nieodwracalnej. Widgetowy `Button` nie daje się
/// przemalować, a formatowanie musi wyglądać inaczej niż reszta.
component DangerButton inherits Rectangle {
    in property <string> caption;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.enabled ? #b04a3a : #8884;
    background: !root.enabled
        ? transparent
        : (danger-touch.has-hover ? #b04a3a : #b04a3a22);

    danger-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.caption;
        vertical-alignment: center;
        horizontal-alignment: center;
        font-size: 13px;
        color: !root.enabled
            ? #888888
            : (danger-touch.has-hover ? #ffffff : #c0563f);
    }
}

export component AppWindow inherits Window {
    title: "MapStick";
    icon: @image-url("../../../packaging/icons/mapstick-256.png");
    min-width: 900px;
    min-height: 640px;
    preferred-width: 1080px;
    preferred-height: 740px;

    // --- wspólne ---
    in property <int> page: 0;
    in property <string> status;
    in property <bool> status-is-error: false;

    // --- widok listy modeli ---
    in property <[string]> brands: ["Hyundai", "Kia", "Genesis"];
    in property <[string]> regions;
    in property <[ModelRow]> models;
    in property <int> total-count;
    in property <bool> busy: false;
    in-out property <int> brand-index: 0;
    in-out property <int> region-index: 0;
    in property <[FavouriteRow]> favourites;
    in property <bool> selected-is-favourite: false;
    /// Czy ten model jest sprawdzany w tle, bez uruchamiania aplikacji.
    in property <bool> selected-watch: false;
    in property <[string]> intervals;
    in-out property <int> interval-index: 1;
    /// Jak często sprawdzanie w tle melduje, że działa; ostatnia pozycja — nigdy.
    in property <[string]> reports;
    in-out property <int> report-index: 1;
    /// Wersje, które mogą siedzieć w aucie — pierwsza pozycja to „nie wiem”.
    in property <[string]> installed-choices;
    in-out property <int> installed-index: 0;
    /// Czym budzi nas system i jak często. Puste — nikt nas nie budzi.
    in property <string> watch-note;
    /// Wyjaśnienie, skąd kilka numerów wersji przy jednym modelu.
    in property <string> variants-note;
    in property <string> favourites-note;

    in property <int> selected-index: -1;
    in property <string> detail-name;
    in property <string> detail-id;
    in property <string> detail-version;
    in property <string> detail-media;
    in property <string> detail-released;
    in property <string> detail-size: "—";
    in property <bool> detail-ready: false;

    // --- widok nośnika ---
    in property <[MediumRow]> media;
    in property <bool> media-busy: false;
    in property <int> selected-medium: -1;
    in property <string> target-summary;

    in property <bool> direct-to-medium: false;
    in property <string> space-note;
    in property <bool> target-has-current: false;
    in property <string> leftovers;
    in property <bool> space-warning: false;

    in property <string> output-dir;
    /// Katalog na dysku twardym z gotowymi danymi. Puste — nie ma czego kopiować.
    in property <string> copy-source;
    /// Nośnik, na który te dane trafią. Puste — nie ma dokąd kopiować.
    in property <string> copy-target;
    in property <bool> delete-after-copy: false;
    in property <bool> copying: false;
    in property <bool> downloading: false;
    /// Pobieranie stoi, ale jest co wznowić — archiwa leżą na dysku.
    in property <bool> paused: false;
    in property <float> progress: 0;
    in property <string> progress-text;

    // --- potwierdzenie formatowania ---
    in property <bool> format-dialog: false;
    in property <string> format-target;
    in property <bool> formatting: false;

    // --- wybór pojazdu po VIN, gdy pasuje kilka ---
    in property <bool> vin-dialog: false;
    in property <[VinChoice]> vin-choices;

    // --- potwierdzenie ponownego pobrania ---
    in property <bool> redownload-dialog: false;
    /// Co zniknie z katalogu docelowego: ile plików i ile miejsca.
    in property <string> redownload-target;

    callback load-models(int, int);
    callback filter-changed(string);
    callback select-row(int);
    callback go-to-media();
    callback go-back();
    callback refresh-media();
    callback select-medium(int);
    callback pick-output-dir();
    callback request-format(int);
    callback remove-stale(int);
    callback confirm-format();
    callback cancel-format();
    callback request-redownload();
    callback confirm-redownload();
    callback cancel-redownload();
    callback start-download();
    callback start-copy();
    callback set-delete-after-copy(bool);
    callback cancel-download();
    callback abandon-download();
    callback set-direct-mode(bool);
    callback clear-cache();
    callback toggle-favourite();
    callback set-watch(bool);
    callback set-interval(int);
    callback set-report(int);
    callback set-installed(int);
    callback open-favourite(string);
    callback find-vin(string);

    /// Przewija listę modeli tak, żeby wiersz stał mniej więcej na środku.
    /// Wołane tylko przy wyborze z zewnątrz — z ulubionych, odnośnika, VIN
    /// albo przy odtwarzaniu — bo kliknięty wiersz i tak jest na widoku.
    /// Lista siedzi w widoku warunkowym, więc nie da się jej przewinąć stąd
    /// wprost: prośba idzie przez licznik, który lista obserwuje.
    public function show-row(index: int) {
        root.scroll-row = index;
        root.scroll-serial += 1;
    }
    property <int> scroll-row: -1;
    property <int> scroll-serial: 0;
    callback choose-vin(int);
    callback cancel-vin();

    VerticalBox {
        padding: 16px;
        spacing: 14px;

        // ================= WIDOK 1: MODELE =================
        if root.page == 0: VerticalLayout {
            spacing: 14px;

            HorizontalLayout {
                spacing: 20px;
                alignment: stretch;

                HorizontalLayout {
                spacing: 10px;
                alignment: start;

                VerticalLayout {
                    spacing: 4px;
                    Text { text: @tr("Brand"); font-size: 12px; opacity: 0.7; }
                    brand-box := ComboBox {
                        width: 150px;
                        model: root.brands;
                        current-index <=> root.brand-index;
                        // Wybór jest poleceniem sam w sobie — bez tego lista
                        // pokazywałaby modele innej marki, niż mówi to pole.
                        selected => {
                            root.load-models(self.current-index, region-box.current-index);
                        }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: @tr("Region"); font-size: 12px; opacity: 0.7; }
                    region-box := ComboBox {
                        width: 210px;
                        model: root.regions;
                        current-index <=> root.region-index;
                        selected => {
                            root.load-models(brand-box.current-index, self.current-index);
                        }
                    }
                }

                // Stan wczytywania zamiast przycisku: wybór marki albo regionu
                // sam pobiera listę, więc nie ma czego naciskać.
                VerticalLayout {
                    spacing: 4px;
                    Text { text: " "; font-size: 12px; }
                    Text {
                        height: 32px;
                        vertical-alignment: center;
                        text: root.busy ? @tr("Loading…") : "";
                        font-size: 12px;
                        opacity: 0.7;
                    }
                }
                }

                // ---------- ulubione ----------
                Rectangle {
                    width: 380px;
                    border-width: 1px;
                    border-color: #8884;
                    border-radius: 4px;
                    background: #0002;

                    VerticalLayout {
                        padding: 6px;
                        alignment: start;

                        if root.favourites.length == 0: Text {
                            text: root.favourites-note;
                            font-size: 12px;
                            opacity: 0.55;
                            wrap: word-wrap;
                        }

                        // Zwykła kolumna, nie lista przewijana: kilka ulubionych
                        // ma być widocznych od razu, bez sięgania po suwak.
                        if root.favourites.length <= 8: VerticalLayout {
                            for f in root.favourites: FavouriteLine {
                                entry: f;
                                activated => { root.open-favourite(f.model_id); }
                            }
                        }

                        // Powyżej tego progu ramka zjadłaby okno, więc wraca suwak.
                        if root.favourites.length > 8: ListView {
                            height: 8 * 22px;
                            for f in root.favourites: FavouriteLine {
                                entry: f;
                                activated => { root.open-favourite(f.model_id); }
                            }
                        }
                    }
                }
            }

            HorizontalBox {
                spacing: 10px;
                padding: 0px;

                LineEdit {
                    placeholder-text: @tr("Filter: name, model ID or version…");
                    enabled: root.total-count > 0;
                    edited(text) => { root.filter-changed(text); }
                }

                Text {
                    vertical-alignment: center;
                    text: root.total-count > 0 ? @tr("{} of {}", root.models.length, root.total-count) : "";
                    font-size: 12px;
                    opacity: 0.7;
                }

                // VIN to skrót, nie jedyna droga — stoi z boku listy, a nie
                // zamiast niej.
                vin-edit := LineEdit {
                    width: 230px;
                    placeholder-text: @tr("VIN (17 characters)");
                    accepted(text) => { root.find-vin(text); }
                }
                Button {
                    text: @tr("Find");
                    enabled: !root.busy && vin-edit.text != "";
                    clicked => { root.find-vin(vin-edit.text); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: #8884;
                border-radius: 4px;
                background: #8881;

                VerticalLayout {
                    padding: 1px;

                    Rectangle {
                        height: 30px;
                        background: #8882;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            Text { width: 30%; text: @tr("NAME"); font-size: 11px; font-weight: 700; vertical-alignment: center; opacity: 0.75; }
                            Text { width: 24%; text: @tr("MODEL ID"); font-size: 11px; font-weight: 700; vertical-alignment: center; opacity: 0.75; }
                            Text { text: @tr("VERSION"); font-size: 11px; font-weight: 700; vertical-alignment: center; opacity: 0.75; }
                            Text { width: 70px; text: @tr("MEDIA"); font-size: 11px; font-weight: 700; vertical-alignment: center; opacity: 0.75; }
                        }
                    }

                    model-list := ListView {
                        property <int> scroll-request: root.scroll-serial;
                        changed scroll-request => {
                            self.viewport-y = min(0px, max(
                                self.visible-height - self.viewport-height,
                                self.visible-height / 2 - 16px - root.scroll-row * 32px));
                        }

                        for row[i] in root.models: Rectangle {
                            height: 32px;
                            background: root.selected-index == i ? #4a90d922 : (touch.has-hover ? #8881 : transparent);

                            touch := TouchArea {
                                clicked => { root.select-row(i); }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                Text { width: 30%; text: row.name; vertical-alignment: center; overflow: elide; }
                                Text { width: 24%; text: row.id; vertical-alignment: center; overflow: elide; font-family: "monospace"; font-size: 12px; }
                                Text { text: row.version; vertical-alignment: center; overflow: elide; font-family: "monospace"; font-size: 12px; }
                                Text { width: 70px; text: row.media; vertical-alignment: center; font-size: 12px; opacity: 0.8; }
                            }
                        }
                    }
                }
            }

            // Wysokość z zawartości, nie z liczby wpisanej na sztywno: karta
            // rośnie o wiersz, gdy model jest ulubiony, i o kolejny, gdy jest
            // pilnowany. Przy 128px ostatni wiersz wychodził poza ramkę
            // i nachodził na pasek stanu.
            Rectangle {
                min-height: 128px;
                vertical-stretch: 0;
                border-width: 1px;
                border-color: #8884;
                border-radius: 4px;
                background: #8881;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    if !root.detail-ready: Text {
                        text: @tr("Pick a model from the list to see its size and prepare a medium.");
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        opacity: 0.6;
                    }

                    if root.detail-ready: VerticalLayout {
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 10px;

                            Text {
                                text: root.detail-name;
                                font-size: 17px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Rectangle {
                                width: 30px;
                                accessible-role: button;
                                accessible-label: root.selected-is-favourite
                                    ? @tr("Remove from favourites")
                                    : @tr("Add to favourites");

                                star-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-favourite(); }
                                }

                                Text {
                                    text: root.selected-is-favourite ? "★" : "☆";
                                    font-size: 24px;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                    color: root.selected-is-favourite
                                        ? #e8b32a
                                        : (star-touch.has-hover ? #e8b32a : #8c8c8c);
                                }
                            }

                            Text {
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                text: root.detail-id;
                                font-family: "monospace";
                                font-size: 12px;
                                opacity: 0.7;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: @tr("{}   ·   media {}", root.detail-version, root.detail-media)
                                + (root.detail-released == "" ? "" : @tr("   ·   latest release {}", root.detail-released));
                            font-size: 12px;
                            opacity: 0.8;
                            overflow: elide;
                        }

                        // Rzeczy, które mają sens dopiero dla zapamiętanego
                        // auta: pilnowanie wydań i to, co w nim siedzi.
                        if root.selected-is-favourite: HorizontalLayout {
                            spacing: 8px;

                            CheckBox {
                                text: @tr("watch for updates");
                                checked: root.selected-watch;
                                toggled => { root.set-watch(self.checked); }
                            }

                            Text {
                                text: @tr("every:");
                                vertical-alignment: center;
                                font-size: 12px;
                                opacity: 0.7;
                            }
                            ComboBox {
                                width: 120px;
                                model: root.intervals;
                                current-index <=> root.interval-index;
                                enabled: root.selected-watch;
                                selected => { root.set-interval(self.current-index); }
                            }

                            Text {
                                text: @tr("status report:");
                                vertical-alignment: center;
                                font-size: 12px;
                                opacity: 0.7;
                            }
                            ComboBox {
                                width: 120px;
                                model: root.reports;
                                current-index <=> root.report-index;
                                enabled: root.selected-watch;
                                selected => { root.set-report(self.current-index); }
                            }

                            Text {
                                text: @tr("in the car:");
                                vertical-alignment: center;
                                font-size: 12px;
                                opacity: 0.7;
                            }
                            ComboBox {
                                horizontal-stretch: 1;
                                min-width: 240px;
                                model: root.installed-choices;
                                current-index <=> root.installed-index;
                                selected => { root.set-installed(self.current-index); }
                            }
                        }

                        if root.selected-is-favourite && root.variants-note != "": Rectangle {
                            height: variants.preferred-height;

                            variants := Text {
                                width: parent.width;
                                text: root.variants-note;
                                font-size: 11px;
                                opacity: 0.7;
                                wrap: word-wrap;
                            }
                        }

                        if root.selected-is-favourite && root.watch-note != "": Rectangle {
                            height: watch-note-text.preferred-height;

                            watch-note-text := Text {
                                width: parent.width;
                                text: root.watch-note;
                                font-size: 11px;
                                opacity: 0.7;
                                wrap: word-wrap;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                text: root.detail-size;
                                font-size: 13px;
                            }
                            Button {
                                text: @tr("Download and prepare a medium →");
                                primary: true;
                                clicked => { root.go-to-media(); }
                            }
                        }
                    }
                }
            }
        }

        // ================= WIDOK 2: NOŚNIK =================
        if root.page == 1: VerticalLayout {
            spacing: 12px;

            HorizontalBox {
                padding: 0px;
                spacing: 12px;
                Button {
                    text: @tr("← Back to the list");
                    enabled: !root.downloading && !root.formatting;
                    clicked => { root.go-back(); }
                }
                Text {
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    text: root.target-summary;
                    font-size: 13px;
                    overflow: elide;
                }
                Button {
                    text: root.media-busy ? @tr("Looking…") : @tr("Refresh");
                    enabled: !root.media-busy && !root.formatting;
                    clicked => { root.refresh-media(); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: #8884;
                border-radius: 4px;
                background: #8881;

                if root.media.length == 0: VerticalLayout {
                    padding: 24px;
                    spacing: 8px;
                    alignment: center;
                    Text {
                        horizontal-alignment: center;
                        text: root.media-busy ? @tr("Looking for media…") : @tr("No removable medium found.");
                        opacity: 0.7;
                    }
                    Text {
                        horizontal-alignment: center;
                        text: @tr("Plug in a USB stick and press “Refresh”. Internal disks and disks\nholding an operating system are skipped on purpose.");
                        font-size: 12px;
                        opacity: 0.55;
                    }
                }

                if root.media.length > 0: ListView {
                    for m[i] in root.media: Rectangle {
                        height: 116px;
                        background: root.selected-medium == i ? #4a90d922 : (mtouch.has-hover ? #8881 : transparent);

                        mtouch := TouchArea {
                            clicked => { root.select-medium(i); }
                        }

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                Text { text: m.label; font-weight: 700; overflow: elide; }
                                Text { text: m.details; font-size: 12px; opacity: 0.75; overflow: elide; }
                                Text {
                                    text: m.id;
                                    font-size: 11px;
                                    font-family: "monospace";
                                    opacity: 0.6;
                                    overflow: elide;
                                }
                                if m.installed_model != "": Text {
                                    text: @tr("found: {}", m.installed_model);
                                    font-size: 11px;
                                    font-family: "monospace";
                                    opacity: 0.6;
                                    overflow: elide;
                                }
                                if m.installed_version != "": Text {
                                    text: m.installed_version;
                                    font-size: 11px;
                                    font-family: "monospace";
                                    opacity: 0.6;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    width: 260px;
                                    horizontal-alignment: right;
                                    text: m.status;
                                    font-size: 12px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                    color: m.usable ? #4a9d5f : #c07830;
                                }
                                if m.stale != "": Button {
                                    text: @tr("Remove old maps ({})", m.stale);
                                    enabled: !root.downloading && !root.copying
                                        && !root.formatting;
                                    clicked => { root.remove-stale(i); }
                                }
                                DangerButton {
                                    caption: @tr("Format as exFAT");
                                    enabled: !root.downloading && !root.copying
                                        && !root.formatting;
                                    clicked => { root.request-format(i); }
                                }
                            }
                        }
                    }
                }
            }

            // Bez narzuconej wysokości: panel bierze tyle, ile trzeba na
            // zawinięte objaśnienie, które bywa długie.
            Rectangle {
                border-width: 1px;
                border-color: #8884;
                border-radius: 4px;
                background: #8881;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    // Czynność główna po lewej i większa od reszty; wybór trybu
                    // obok niej, a rzadko używany wybór katalogu na końcu.
                    HorizontalLayout {
                        spacing: 14px;

                        // Wstrzymane pobieranie ma własną parę wyjść: wrócić
                        // do niego albo zamknąć sprawę razem z archiwami.
                        if root.paused && !root.downloading && !root.copying: Button {
                            width: 190px;
                            height: 42px;
                            text: @tr("Resume");
                            primary: true;
                            enabled: root.output-dir != "" && !root.formatting;
                            clicked => { root.start-download(); }
                        }
                        if root.paused && !root.downloading && !root.copying: Button {
                            width: 150px;
                            height: 42px;
                            text: @tr("Cancel and clean up");
                            clicked => { root.abandon-download(); }
                        }

                        if !root.paused && !root.downloading && !root.copying
                                && root.copy-source != "" && root.copy-target != "": Button {
                            width: 190px;
                            height: 42px;
                            text: @tr("Copy to the medium");
                            primary: true;
                            enabled: !root.formatting;
                            clicked => { root.start-copy(); }
                        }
                        // Pobranie zostaje w zasięgu ręki nawet wtedy, gdy te
                        // same dane leżą już na dysku twardym: kopiowanie jest
                        // tańsze, ale to użytkownik decyduje, czego chce.
                        if !root.paused && !root.downloading && !root.copying
                                && !root.target-has-current: Button {
                            width: 190px;
                            height: 42px;
                            text: @tr("Download");
                            primary: root.copy-source == "" || root.copy-target == "";
                            enabled: root.output-dir != "" && !root.formatting;
                            clicked => { root.start-download(); }
                        }
                        // Wszystko już jest na miejscu, więc nie ma czego
                        // proponować — ale wyszarzony przycisk zostawiałby
                        // uszkodzone pobranie bez żadnego wyjścia. Stąd droga
                        // powrotna, bez wyróżnienia: rzadko się jej chce.
                        if !root.paused && !root.downloading && !root.copying
                                && root.target-has-current: Button {
                            width: 190px;
                            height: 42px;
                            text: @tr("Download again");
                            enabled: root.output-dir != "" && !root.formatting;
                            clicked => { root.request-redownload(); }
                        }
                        // Dwa różne zamiary, dwa przyciski. Wstrzymanie
                        // zostawia archiwa, żeby było co wznowić; anulowanie
                        // sprząta po sobie — dziesiątki gigabajtów nie mogą
                        // zostawać przypadkiem.
                        if root.downloading: Button {
                            width: 190px;
                            height: 42px;
                            text: @tr("Pause");
                            clicked => { root.cancel-download(); }
                        }
                        if root.downloading: Button {
                            width: 150px;
                            height: 42px;
                            text: @tr("Cancel and clean up");
                            clicked => { root.abandon-download(); }
                        }
                        if root.copying: Button {
                            width: 190px;
                            height: 42px;
                            text: @tr("Cancel");
                            clicked => { root.cancel-download(); }
                        }

                        WrapCheckBox {
                            horizontal-stretch: 1;
                            min-width: 220px;
                            caption: @tr("Download straight to the removable medium, bypassing the hard disk");
                            checked: root.direct-to-medium;
                            enabled: !root.downloading;
                            toggled(on) => { root.set-direct-mode(on); }
                        }

                        Button {
                            text: @tr("Other folder…");
                            enabled: !root.downloading;
                            clicked => { root.pick-output-dir(); }
                        }
                    }

                    // Samo `wrap` nie wystarcza: tekst w układzie sam zgłasza
                    // szerokość całego zdania i rozpycha rząd zamiast się złamać.
                    // Dopiero szerokość wzięta wprost od rodzica zmusza go do
                    // zawijania na tyle wierszy, ile potrzeba.
                    Rectangle {
                        height: note.preferred-height;

                        note := Text {
                            width: parent.width;
                            text: root.space-note;
                            font-size: 12px;
                            color: root.space-warning ? #c07830 : #808080;
                            wrap: word-wrap;
                        }
                    }

                    Text {
                        text: root.output-dir == ""
                            ? @tr("Pick a medium from the list above or choose another folder.")
                            : root.output-dir;
                        font-size: 12px;
                        opacity: root.output-dir == "" ? 0.6 : 0.85;
                        overflow: elide;
                    }

                    if root.copy-source != "" && root.copy-target != ""
                            && !root.downloading && !root.copying: VerticalLayout {
                        spacing: 3px;

                        Rectangle {
                            height: ready.preferred-height;

                            ready := Text {
                                width: parent.width;
                                text: @tr("This firmware is already on the hard disk — no need to download it twice.");
                                font-size: 12px;
                                color: #4a9d5f;
                                wrap: word-wrap;
                            }
                        }
                        Text {
                            text: root.copy-source;
                            font-size: 11px;
                            font-family: "monospace";
                            opacity: 0.7;
                            overflow: elide;
                        }
                        Text {
                            text: "→ " + root.copy-target;
                            font-size: 11px;
                            font-family: "monospace";
                            opacity: 0.7;
                            overflow: elide;
                        }
                        CheckBox {
                            text: @tr("delete from the disk after copying");
                            checked: root.delete-after-copy;
                            toggled => { root.set-delete-after-copy(self.checked); }
                        }
                    }

                    if root.target-has-current && !root.downloading: Rectangle {
                        height: current.preferred-height;

                        current := Text {
                            width: parent.width;
                            text: @tr("The current version is already in the chosen place.");
                            font-size: 12px;
                            color: #4a9d5f;
                            wrap: word-wrap;
                        }
                    }

                    if root.leftovers != "" && !root.downloading: HorizontalLayout {
                        spacing: 10px;
                        Text {
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            text: @tr("Leftover archives on the disk: {}", root.leftovers);
                            font-size: 12px;
                            opacity: 0.75;
                        }
                        Button {
                            text: @tr("Clear");
                            clicked => { root.clear-cache(); }
                        }
                    }

                    if root.downloading || root.copying: VerticalLayout {
                        spacing: 4px;
                        ProgressIndicator { height: 8px; progress: root.progress; }
                        Text { text: root.progress-text; font-size: 12px; opacity: 0.8; }
                    }
                }
            }
        }

        Text {
            text: root.status;
            font-size: 12px;
            color: root.status-is-error ? #d05050 : #808080;
            overflow: elide;
        }
    }

    // ================= WYBÓR POJAZDU PO VIN =================
    if root.vin-dialog: Rectangle {
        background: #000000bb;

        TouchArea {}

        Rectangle {
            width: 560px;
            height: vin-layout.preferred-height;
            background: #2b2b2b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #4a90d9;

            vin-layout := VerticalLayout {
                padding: 22px;
                spacing: 10px;

                Text {
                    text: @tr("Which car is it?");
                    font-size: 19px;
                    font-weight: 700;
                    color: #f0f0f0;
                }

                Text {
                    text: @tr("The maker’s site gives more than one model for this VIN. Pick the one on the car’s screen — the platform is shown under Settings → System info.");
                    font-size: 13px;
                    color: #c8c8c8;
                    wrap: word-wrap;
                }

                for choice[i] in root.vin-choices: Rectangle {
                    height: 52px;
                    border-radius: 4px;
                    background: choice-touch.has-hover ? #4a90d933 : #ffffff0d;

                    choice-touch := TouchArea {
                        clicked => { root.choose-vin(i); }
                    }

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;
                        Text { text: choice.title; font-size: 14px; font-weight: 700; color: #f0f0f0; }
                        Text { text: choice.details; font-size: 12px; font-family: "monospace"; color: #c8c8c8; overflow: elide; }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.cancel-vin(); }
                    }
                }
            }
        }
    }

    // ============== POTWIERDZENIE PONOWNEGO POBRANIA ==============
    if root.redownload-dialog: Rectangle {
        background: #000000bb;

        TouchArea {}

        Rectangle {
            width: 520px;
            height: 280px;
            background: #2b2b2b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #c07830;

            VerticalLayout {
                padding: 22px;
                spacing: 12px;

                Text {
                    text: @tr("Download the same thing again?");
                    font-size: 19px;
                    font-weight: 700;
                    color: #f0f0f0;
                }

                Text {
                    text: root.redownload-target;
                    font-size: 13px;
                    font-family: "monospace";
                    color: #e0c090;
                    wrap: word-wrap;
                }

                Text {
                    text: @tr("Downloading skips files that are already there, so they have to be removed first. Only what this model’s .ver file lists will be deleted — nothing else in that place is touched.");
                    font-size: 13px;
                    color: #c8c8c8;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.cancel-redownload(); }
                    }
                    Button {
                        text: @tr("Delete and download");
                        clicked => { root.confirm-redownload(); }
                    }
                }
            }
        }
    }

    // ================= POTWIERDZENIE FORMATOWANIA =================
    if root.format-dialog: Rectangle {
        background: #000000bb;

        TouchArea {}

        Rectangle {
            width: 520px;
            height: 260px;
            background: #2b2b2b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #c07830;

            VerticalLayout {
                padding: 22px;
                spacing: 12px;

                Text {
                    text: @tr("Erase everything on this medium?");
                    font-size: 19px;
                    font-weight: 700;
                    color: #f0f0f0;
                }

                Text {
                    text: root.format-target;
                    font-size: 13px;
                    font-family: "monospace";
                    color: #e0c090;
                    wrap: word-wrap;
                }

                Text {
                    text: @tr("Formatting as exFAT removes all data from this medium for good. Make sure the drive shown is the one you have in mind.");
                    font-size: 13px;
                    color: #c8c8c8;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.cancel-format(); }
                    }
                    Button {
                        text: root.formatting ? @tr("Formatting…") : @tr("Format");
                        enabled: !root.formatting;
                        clicked => { root.confirm-format(); }
                    }
                }
            }
        }
    }
}
