[Desktop Entry]
Type=Application
Name=MapStick
GenericName=Navigation map updater
GenericName[pl]=Aktualizacja map nawigacji
Comment=Download navigation map updates for Hyundai, Kia and Genesis onto a USB drive
Comment[pl]=Pobieranie aktualizacji map nawigacji Hyundaia, Kii i Genesisa na pendrive
Exec=mapstick %u
Icon=mapstick
Terminal=false
Categories=Utility;
Keywords=Hyundai;Kia;Genesis;navigation;maps;firmware;USB;
# The maker's site starts its updater through these schemes when you press
# "Download". On Windows and macOS they belong to the official Navigation
# Updater; on Linux nothing handles them unless this file is installed.
MimeType=x-scheme-handler/com.hyundai.update.nau;x-scheme-handler/com.kia.update.nau;x-scheme-handler/com.genesis.update.nau;
